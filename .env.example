# Prisma runtime (pooled). On Vercel Postgres, copy POSTGRES_PRISMA_URL into DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hsbc_demo?schema=public"
# Prisma migrations (non-pooled). Neon on Vercel sets POSTGRES_URL_NON_POOLING automatically.
POSTGRES_URL_NON_POOLING="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hsbc_demo?schema=public"

# Public origin of the app, used for CSRF origin checks and reset links.
APP_URL="http://localhost:3000"

# Demo only: when "true", the forgot-password API returns the reset link in its
# response because no email provider is configured. Keep "false" on any public deployment.
DEMO_EXPOSE_RESET_LINK="true"

# Login OTP for raja@hsbcuk.co.uk → +919176253212
LOGIN_OTP_PEPPER=""

# Built-in SMS gateway (Option D) — webhook on this app sends OTP to that number
LOGIN_OTP_USE_BUILTIN_WEBHOOK="true"
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOGIN_OTP_WEBHOOK_SECRET=""
# Or set LOGIN_OTP_WEBHOOK_URL to a custom HTTPS endpoint instead of built-in

# Inside the gateway: optional external SMS server (POST { phone, mobile, otp, message })
OTP_GATEWAY_HTTP_URL=""
OTP_GATEWAY_HTTP_KEY=""

# Or use a provider key (gateway calls 2Factor/MSG91/Twilio/Fast2SMS)
LOGIN_OTP_SMS_PROVIDERS="twofactor,msg91,twilio,fast2sms"

# Other channels (optional fallbacks)
LOGIN_OTP_DELIVERY_ORDER="webhook"
CALLMEBOT_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HSBC UK Log on <onboarding@resend.dev>"

# SMS provider credentials (used by built-in gateway)
# MSG91 — https://msg91.com — Auth Key from dashboard
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""
# Optional custom SMS text (##OTP## replaced if used in MSG91 template)
MSG91_OTP_MESSAGE=""

# 2Factor.in — https://2factor.in — API key from account
TWOFACTOR_API_KEY=""
TWOFACTOR_TEMPLATE_NAME=""

# Twilio (international)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Fast2SMS (optional)
FAST2SMS_API_KEY=""
FAST2SMS_OTP_ID=""
FAST2SMS_OTP_VARIABLES=""

# Local testing only — shows OTP on screen. Never enable on production.
DEMO_EXPOSE_LOGIN_OTP="false"
